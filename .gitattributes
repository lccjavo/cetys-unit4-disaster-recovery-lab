# Force LF line endings for everything that runs inside Linux containers or Bash.
# Without this, Git for Windows (core.autocrlf=true) checks these files out with CRLF,
# and the PostgreSQL container fails with "env: 'bash\r': No such file or directory".
* text=auto
*.sh text eol=lf
*.sql text eol=lf
*.js text eol=lf
*.ejs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
.dockerignore text eol=lf
*.ps1 text eol=crlf
