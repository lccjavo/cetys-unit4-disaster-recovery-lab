<%- include('../partials/header') %>
<%
  const allowedSet = new Set(allowed);
  const fieldsFor = (groups) => F.SENSITIVE_FIELDS.filter(f => groups.includes(f.group));
  const vaultReady = vaultHealth.available && vaultHealth.vault_status === 'READY' && !vaultHealth.access_disabled;
  const yesNo = (b) => b ? 'Yes' : 'No';
%>
<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-2">
  <div>
    <nav aria-label="Breadcrumb"><ol class="breadcrumb small mb-1">
      <% if (user.role !== 'customer') { %><li class="breadcrumb-item"><a href="/customers">Customers</a></li><% } %>
      <li class="breadcrumb-item active" aria-current="page"><%= c.customer_code %></li>
    </ol></nav>
    <h1><%= c.full_name %> <%- include('../partials/badges', { customerStatus: c.status }) %></h1>
    <p class="lead"><i class="bi bi-geo-alt me-1"></i><%= c.city %>, <%= c.country %> · <span class="mono"><%= c.username %></span></p>
  </div>
  <a href="/reservations/new?customer_id=<%= c.id %>" class="btn btn-cyan btn-sm"><i class="bi bi-calendar-plus me-1"></i>New reservation</a>
</div>

<div class="card">
  <div class="card-header bg-white pb-0 border-0">
    <ul class="nav nav-tabs flex-nowrap overflow-auto" role="tablist">
      <% const tabs = [['overview', 'grid', 'Overview'], ['personal', 'person', 'Personal information'], ['financial', 'credit-card', 'Financial information'], ['family', 'people', 'Family and guests'], ['preferences', 'sliders', 'Preferences'], ['reservations', 'calendar-check', 'Reservations'], ['encryption', 'shield-lock', 'Encryption details']]; %>
      <% tabs.forEach(([id, icon, label], i) => { %>
        <li class="nav-item" role="presentation">
          <button class="nav-link text-nowrap <%= i === 0 ? 'active' : '' %>" id="btn-<%= id %>" data-bs-toggle="tab" data-bs-target="#tab-<%= id %>" type="button" role="tab" aria-controls="tab-<%= id %>" aria-selected="<%= i === 0 %>"><i class="bi bi-<%= icon %> me-1"></i><%= label %></button>
        </li>
      <% }) %>
    </ul>
  </div>
  <div class="card-body">
    <div class="tab-content">

      <div class="tab-pane fade show active" id="tab-overview" role="tabpanel" aria-labelledby="btn-overview">
        <div class="row g-3">
          <div class="col-12 col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Code</div><div class="stat-value mono"><%= c.customer_code %></div></div></div></div>
          <div class="col-12 col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Loyalty</div><div class="stat-value"><%= c.loyalty_tier %></div></div></div></div>
          <div class="col-12 col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Reservations</div><div class="stat-value"><%= reservations.length %></div></div></div></div>
          <div class="col-12 col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">KEK of this DEK</div><div class="stat-value mono"><%= c.kek_id || 'N/A' %></div></div></div></div>
        </div>
        <div class="row g-3 mt-1">
          <div class="col-12 col-lg-6">
            <h2 class="h6 mt-2">Operational data (not encrypted by the application)</h2>
            <div class="field-row d-flex justify-content-between"><span class="field-label">Nickname</span><span class="field-value"><%= c.display_nickname %></span></div>
            <div class="field-row d-flex justify-content-between"><span class="field-label">Language</span><span class="field-value"><%= c.preferred_language %></span></div>
            <div class="field-row d-flex justify-content-between"><span class="field-label">Time zone</span><span class="field-value"><%= c.time_zone %></span></div>
            <div class="field-row d-flex justify-content-between"><span class="field-label">Currency</span><span class="field-value"><%= c.preferred_currency %></span></div>
            <div class="field-row d-flex justify-content-between"><span class="field-label">Contact channel</span><span class="field-value"><%= c.preferred_contact_channel %></span></div>
          </div>
          <div class="col-12 col-lg-6">
            <h2 class="h6 mt-2">Data classification</h2>
            <div class="alert alert-info small mb-2"><i class="bi bi-lock-fill me-1"></i><strong>20 sensitive fields</strong> encrypted with AES-256-GCM. They stay masked until you ask to reveal them; the server checks your authorization and asks the Key Vault to unwrap the DEK.</div>
            <div class="alert alert-light border small mb-2"><i class="bi bi-unlock me-1"></i><strong>20 operational fields</strong> stored as regular columns, protected by authentication and authorization.</div>
            <p class="small text-secondary mb-0">Your role (<strong><%= user.role %></strong>) may reveal <strong><%= allowed.length %></strong> of the 20 sensitive fields in this profile.</p>
          </div>
        </div>
      </div>

      <% [['personal', ['contact', 'identity', 'emergency']], ['financial', ['financial', 'employment']], ['family', ['family']]].forEach(([tab, groups]) => { const list = fieldsFor(groups); const can = list.filter(f => allowedSet.has(f.key)).map(f => f.key); %>
      <div class="tab-pane fade" id="tab-<%= tab %>" role="tabpanel" aria-labelledby="btn-<%= tab %>">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <p class="small text-secondary mb-0"><i class="bi bi-lock-fill text-cyan me-1"></i>Values are encrypted in PostgreSQL and masked by default.</p>
          <% if (can.length) { %>
            <button type="button" class="btn btn-sm btn-cyan" data-reveal-group data-customer-id="<%= c.id %>" data-fields="<%= can.join(',') %>" data-target="#tab-<%= tab %>" <%= vaultReady ? '' : 'title="The Key Vault is not available"' %>><i class="bi bi-unlock me-1"></i>Reveal sensitive information (<%= can.length %>)</button>
          <% } %>
        </div>
        <div data-role="reveal-status" class="d-none"></div>
        <% if (!vaultReady) { %><div class="alert alert-warning small"><i class="bi bi-safe me-1"></i>Key Vault unavailable or key access disabled: encrypted fields are temporarily unreadable. The data remains securely stored.</div><% } %>
        <% groups.forEach(g => { %>
          <h2 class="h6 mt-3 text-cyan"><%= F.GROUPS[g] %></h2>
          <div class="row">
          <% fieldsFor([g]).forEach(f => { %>
            <div class="col-12 col-md-6">
              <div class="field-row">
                <div class="field-label"><%= f.label %> <span class="mono text-secondary">(<%= f.key %>)</span></div>
                <% if (allowedSet.has(f.key)) { %>
                  <div class="field-value masked" data-field="<%= f.key %>">•••••••••• <span class="badge text-bg-light border fw-normal">encrypted</span></div>
                <% } else { %>
                  <div class="field-value"><span class="badge text-bg-warning"><i class="bi bi-shield-lock me-1"></i>Restricted for your role</span></div>
                <% } %>
              </div>
            </div>
          <% }) %>
          </div>
        <% }) %>
      </div>
      <% }) %>

      <div class="tab-pane fade" id="tab-preferences" role="tabpanel" aria-labelledby="btn-preferences">
        <p class="small text-secondary"><i class="bi bi-unlock me-1"></i>The 20 lower-sensitivity operational fields (for this scenario). They do not use application encryption, so they stay visible even when the Key Vault is down.</p>
        <div class="row">
          <% F.OPERATIONAL_FIELDS.forEach(f => { %>
            <div class="col-12 col-md-6 col-xl-4">
              <div class="field-row d-flex justify-content-between gap-2"><span class="field-label"><%= f.label %></span><span class="field-value text-end"><%= f.type === 'bool' ? yesNo(c[f.key]) : c[f.key] %></span></div>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="tab-pane fade" id="tab-reservations" role="tabpanel" aria-labelledby="btn-reservations">
        <% if (!reservations.length) { %>
          <div class="empty-state"><i class="bi bi-calendar-x"></i><p class="mt-2">This customer has no reservations.</p><a href="/reservations/new?customer_id=<%= c.id %>" class="btn btn-sm btn-primary">Create reservation</a></div>
        <% } else { %>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
          <thead><tr><th>ID</th><th>Code</th><th>Customer</th><th>Room</th><th>Check-in</th><th>Check-out</th><th>Nights</th><th>Status</th><th class="text-end">Total</th></tr></thead>
          <tbody><% reservations.forEach(r => { %>
            <tr><td><%= r.id %></td><td class="mono"><%= r.reservation_code %></td><td class="mono"><%= r.customer_id %></td><td><%= r.room_type %></td><td><%= r.check_in_s %></td><td><%= r.check_out_s %></td><td><%= r.nights %></td><td><%- include('../partials/badges', { reservationStatus: r.status }) %></td><td class="text-end"><%= money(r.total_amount) %></td></tr>
          <% }) %></tbody>
        </table></div>
        <% } %>
      </div>

      <div class="tab-pane fade" id="tab-encryption" role="tabpanel" aria-labelledby="btn-encryption">
        <div class="alert alert-light border small"><i class="bi bi-info-circle me-1"></i>This tab shows <strong>metadata and ciphertext</strong>, never the DEK or KEK in plaintext. The <code>kek_id</code> is only a reference: the KEK material lives in the Key Vault, outside PostgreSQL.</div>
        <div class="row g-3">
          <div class="col-12 col-lg-5">
            <h2 class="h6">Customer DEK (table <code>customer_keys</code>)</h2>
            <div class="field-row"><div class="field-label">Sensitive fields encrypted?</div><div class="field-value"><%= c.encrypted_fields ? `Yes, ${Object.keys(c.encrypted_fields).length} fields` : 'No' %></div></div>
            <div class="field-row"><div class="field-label">DEK reference (dek_ref)</div><div class="mono"><%= c.dek_ref %></div></div>
            <div class="field-row"><div class="field-label">kek_id (KEK that wraps the DEK)</div><div class="mono fw-semibold"><%= c.kek_id %></div></div>
            <div class="field-row"><div class="field-label">Wrapping / field algorithm</div><div><%= c.wrap_algorithm %> / <%= c.encryption_algorithm %></div></div>
            <div class="field-row"><div class="field-label">Encryption schema version</div><div><%= c.encryption_schema_version %></div></div>
            <div class="field-row"><div class="field-label">Wrapped DEK (wrapped_dek, base64)</div><div class="mono small"><%= c.wrapped_dek %></div></div>
            <div class="field-row"><div class="field-label">Wrapping nonce / GCM tag</div><div class="mono small"><%= c.dek_wrap_nonce %> / <%= c.dek_wrap_tag %></div></div>
            <div class="field-row"><div class="field-label">Created / re-wrapped</div><div class="small"><%= fmtDate(c.key_created_at) %> / <%= c.rewrapped_at ? fmtDate(c.rewrapped_at) : 'never' %></div></div>
            <div class="field-row"><div class="field-label">Key Vault</div><div><span class="status-dot <%= vaultReady ? 'ok' : 'down' %>"></span><%= vaultReady ? 'Available' : 'Unavailable / access restricted' %></div></div>
          </div>
          <div class="col-12 col-lg-7">
            <h2 class="h6">Encrypted fields (table <code>customer_sensitive_data</code>)</h2>
            <p class="small text-secondary">Per-field AAD: <code>hotel-lab|field|v1|customer:<%= c.id %>|field:&lt;name&gt;</code></p>
            <div class="table-responsive" style="max-height: 420px"><table class="table table-sm align-middle mb-0">
              <thead class="sticky-top"><tr><th>Field</th><th>Nonce (96 bits)</th><th>Tag</th><th>Ciphertext</th><th class="text-end">Bytes</th></tr></thead>
              <tbody><% fieldMeta.forEach(f => { %>
                <tr><td class="mono small"><%= f.key %></td><td class="mono small"><%= f.nonce %></td><td class="mono small"><%= (f.tag || '').slice(0, 10) %>…</td><td class="mono small"><%= (f.ct || '').slice(0, 18) %>…</td><td class="text-end small"><%= f.ctBytes %></td></tr>
              <% }) %></tbody>
            </table></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
<%- include('../partials/footer') %>
