<%- include('partials/header') %>
<% const sc = s.schema.ok ? s.schema.value : null; const vs = s.vaultStatus.ok ? s.vaultStatus.value : null; %>
<div class="page-header">
  <h1>Seguridad y cifrado</h1>
  <p class="lead">Cifrado de sobre: un DEK aleatorio por cliente cifra sus 20 campos; el Key Vault envuelve cada DEK con un KEK. Nunca se muestran DEK ni KEK en claro.</p>
</div>
<div class="row g-3">
  <% const cards = [
      ['shield-check', '¿Campos sensibles cifrados?', sc ? (sc.complete_profiles === sc.customers ? 'Sí, todos' : `${sc.complete_profiles}/${sc.customers}`) : 'N/D', sc ? `${sc.customers} perfiles · 20 campos c/u` : ''],
      ['key', 'DEKs únicos', sc ? sc.distinct_deks : 'N/D', sc ? `${sc.wrapped_deks} envueltos · ${sc.customers_without_key} sin DEK` : ''],
      ['safe2', 'Key Vault', s.vaultHealth.available ? s.vaultHealth.vault_status : 'No disponible', s.vaultHealth.available ? `KEK activo: ${s.vaultHealth.active_kek_id}` : s.vaultHealth.error],
      ['hdd', 'Tamaño cifrado', sc ? sc.encrypted_size : 'N/D', sc ? `~${sc.avg_encrypted_bytes} B cifrados vs ~${sc.avg_operational_row_bytes} B operativos por cliente` : ''],
  ]; %>
  <% cards.forEach(([icon, label, value, sub]) => { %>
    <div class="col-12 col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body d-flex gap-3 align-items-center">
      <span class="stat-icon"><i class="bi bi-<%= icon %>"></i></span>
      <div><div class="stat-label"><%= label %></div><div class="stat-value"><%= value %></div><div class="small text-secondary"><%= sub %></div></div>
    </div></div></div>
  <% }) %>
</div>
<div class="row g-3 mt-1">
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-diagram-3 me-1"></i>DEKs por KEK (PostgreSQL vs Key Vault)</div>
      <div class="card-body p-0">
        <% if (!s.kekUsage.ok) { %><div class="empty-state"><i class="bi bi-database-x"></i><p class="mt-2 mb-0"><%= s.kekUsage.message %></p></div>
        <% } else { const known = vs ? new Map(vs.keks.map(k => [k.kek_id, k])) : new Map(); %>
        <div class="table-responsive"><table class="table align-middle mb-0">
          <thead><tr><th>kek_id</th><th class="text-end">Clientes</th><th>En el Key Vault</th><th>Estado</th></tr></thead>
          <tbody>
          <% s.kekUsage.value.forEach(k => { const v = known.get(k.kek_id); %>
            <tr><td class="mono"><%= k.kek_id %></td><td class="text-end"><%= k.customers %></td>
              <td><% if (!vs) { %><span class="badge text-bg-secondary">No verificable</span><% } else if (v) { %><span class="badge text-bg-success">Existe</span><% } else { %><span class="badge text-bg-danger">KEK no encontrado</span><% } %></td>
              <td><%= v ? (v.status === 'active' ? 'Activo' : 'Retirado (solo desenvuelve)') : '' %></td></tr>
          <% }) %>
          </tbody></table></div>
        <% } %>
      </div>
      <div class="card-footer bg-white">
        <form method="post" action="/security/rewrap" class="d-flex flex-wrap align-items-center gap-2">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" class="btn btn-sm btn-outline-primary" <%= vs ? '' : 'disabled' %> data-confirm="Los DEK envueltos con KEK anteriores se re-envolverán con el KEK activo (<%= vs ? vs.active_kek_id : '' %>). El DEK nunca sale del Key Vault durante esta operación y los datos cifrados no cambian." data-confirm-title="Re-envolver DEKs" data-confirm-variant="btn-primary"><i class="bi bi-arrow-repeat me-1"></i>Re-envolver DEKs al KEK activo</button>
          <span class="small text-secondary">Opcional, después de rotar el KEK en el Key Vault.</span>
        </form>
      </div>
    </div>
  </div>
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-gear me-1"></i>Parámetros criptográficos</div>
      <div class="card-body small">
        <div class="field-row d-flex justify-content-between"><span class="field-label">Algoritmo de campos</span><span>AES-256-GCM</span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">Nonce por campo</span><span>96 bits, aleatorio en cada cifrado</span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">Etiqueta de autenticación</span><span>128 bits</span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">AAD de campo</span><span class="mono">cliente + campo + versión</span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">DEK</span><span>256 bits, uno por cliente</span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">Envoltura de DEK</span><span>AES-256-GCM con KEK, AAD = kek_id + cliente + dek_ref</span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">Contraseñas</span><span>Argon2id (m=19 MiB, t=2, p=1)</span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">Canal hotel &rarr; Key Vault</span><span>HTTP interno + token de servicio</span></div>
        <% if (vs) { %>
        <div class="field-row d-flex justify-content-between"><span class="field-label">Operaciones wrap / unwrap</span><span><%= vs.counters.wrap %> / <%= vs.counters.unwrap %></span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">Último respaldo de KEK</span><span><%= vs.last_backup ? fmtDate(vs.last_backup.at) : 'nunca' %></span></div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<div class="card mt-3">
  <div class="card-header"><i class="bi bi-table me-1"></i>Muestra de lo que realmente guarda PostgreSQL</div>
  <div class="card-body p-0">
    <% if (!s.sample.ok) { %><div class="empty-state"><i class="bi bi-database-x"></i><p class="mt-2 mb-0"><%= s.sample.message %></p></div>
    <% } else { %>
    <div class="table-responsive"><table class="table table-sm align-middle mb-0">
      <thead><tr><th>ID</th><th>Código</th><th>Nombre</th><th>kek_id</th><th>dek_ref</th><th>wrapped_dek (inicio)</th><th>phone_number.ciphertext (inicio)</th></tr></thead>
      <tbody><% s.sample.value.forEach(r => { %>
        <tr><td><%= r.id %></td><td><a href="/customers/<%= r.id %>#tab-encryption" class="mono"><%= r.customer_code %></a></td><td><%= r.full_name %></td><td class="mono"><%= r.kek_id %></td><td class="mono small"><%= r.dek_ref %></td><td class="mono small"><%= r.wrapped_preview %>…</td><td class="mono small"><%= r.phone_ct %>…</td></tr>
      <% }) %></tbody>
    </table></div>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
