<%- include('partials/header') %>
<% const sc = s.schema.ok ? s.schema.value : null; const vs = s.vaultStatus.ok ? s.vaultStatus.value : null; %>
<div class="page-header">
  <h1>Security and encryption</h1>
  <p class="lead">Envelope encryption: one random DEK per customer encrypts its 20 fields; the Key Vault wraps each DEK with a KEK. DEKs and KEKs are never shown in plaintext.</p>
</div>
<div class="row g-3">
  <% const cards = [
      ['shield-check', 'Sensitive fields encrypted?', sc ? (sc.complete_profiles === sc.customers ? 'Yes, all' : `${sc.complete_profiles}/${sc.customers}`) : 'N/A', sc ? `${sc.customers} profiles · 20 fields each` : ''],
      ['key', 'Unique DEKs', sc ? sc.distinct_deks : 'N/A', sc ? `${sc.wrapped_deks} wrapped · ${sc.customers_without_key} without a DEK` : ''],
      ['safe2', 'Key Vault', s.vaultHealth.available ? s.vaultHealth.vault_status : 'Unavailable', s.vaultHealth.available ? `Active KEK: ${s.vaultHealth.active_kek_id}` : s.vaultHealth.error],
      ['hdd', 'Encrypted size', sc ? sc.encrypted_size : 'N/A', sc ? `~${sc.avg_encrypted_bytes} B encrypted vs ~${sc.avg_operational_row_bytes} B operational per customer` : ''],
  ]; %>
  <% cards.forEach(([icon, label, value, sub]) => { %>
    <div class="col-12 col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body d-flex gap-3 align-items-center">
      <span class="stat-icon"><i class="bi bi-<%= icon %>"></i></span>
      <div><div class="stat-label"><%= label %></div><div class="stat-value"><%= value %></div><div class="small text-secondary"><%= sub %></div></div>
    </div></div></div>
  <% }) %>
</div>
<div class="row g-3 mt-1">
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-diagram-3 me-1"></i>DEKs per KEK (PostgreSQL vs Key Vault)</div>
      <div class="card-body p-0">
        <% if (!s.kekUsage.ok) { %><div class="empty-state"><i class="bi bi-database-x"></i><p class="mt-2 mb-0"><%= s.kekUsage.message %></p></div>
        <% } else { const known = vs ? new Map(vs.keks.map(k => [k.kek_id, k])) : new Map(); %>
        <div class="table-responsive"><table class="table align-middle mb-0">
          <thead><tr><th>kek_id</th><th class="text-end">Customers</th><th>In the Key Vault</th><th>Status</th></tr></thead>
          <tbody>
          <% s.kekUsage.value.forEach(k => { const v = known.get(k.kek_id); %>
            <tr><td class="mono"><%= k.kek_id %></td><td class="text-end"><%= k.customers %></td>
              <td><% if (!vs) { %><span class="badge text-bg-secondary">Cannot verify</span><% } else if (v) { %><span class="badge text-bg-success">Exists</span><% } else { %><span class="badge text-bg-danger">KEK not found</span><% } %></td>
              <td><%= v ? (v.status === 'active' ? 'Active' : 'Retired (unwrap only)') : '' %></td></tr>
          <% }) %>
          </tbody></table></div>
        <% } %>
      </div>
      <div class="card-footer bg-white">
        <form method="post" action="/security/rewrap" class="d-flex flex-wrap align-items-center gap-2">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" class="btn btn-sm btn-outline-primary" <%= vs ? '' : 'disabled' %> data-confirm="DEKs wrapped with older KEKs will be re-wrapped with the active KEK (<%= vs ? vs.active_kek_id : '' %>). The DEK never leaves the Key Vault during this operation and the encrypted data does not change." data-confirm-title="Re-wrap DEKs" data-confirm-variant="btn-primary"><i class="bi bi-arrow-repeat me-1"></i>Re-wrap DEKs with the active KEK</button>
          <span class="small text-secondary">Optional, after rotating the KEK in the Key Vault.</span>
        </form>
      </div>
    </div>
  </div>
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-gear me-1"></i>Cryptographic parameters</div>
      <div class="card-body small">
        <div class="field-row d-flex justify-content-between"><span class="field-label">Field algorithm</span><span>AES-256-GCM</span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">Per-field nonce</span><span>96 bits, random on every encryption</span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">Authentication tag</span><span>128 bits</span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">Field AAD</span><span class="mono">customer + field + version</span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">DEK</span><span>256 bits, one per customer</span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">DEK wrapping</span><span>AES-256-GCM with the KEK, AAD = kek_id + customer + dek_ref</span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">Passwords</span><span>Argon2id (m=19 MiB, t=2, p=1)</span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">Canal hotel &rarr; Key Vault</span><span>Internal HTTP + service token</span></div>
        <% if (vs) { %>
        <div class="field-row d-flex justify-content-between"><span class="field-label">Wrap / unwrap operations</span><span><%= vs.counters.wrap %> / <%= vs.counters.unwrap %></span></div>
        <div class="field-row d-flex justify-content-between"><span class="field-label">Last KEK backup</span><span><%= vs.last_backup ? fmtDate(vs.last_backup.at) : 'never' %></span></div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<div class="card mt-3">
  <div class="card-header"><i class="bi bi-table me-1"></i>Sample of what PostgreSQL actually stores</div>
  <div class="card-body p-0">
    <% if (!s.sample.ok) { %><div class="empty-state"><i class="bi bi-database-x"></i><p class="mt-2 mb-0"><%= s.sample.message %></p></div>
    <% } else { %>
    <div class="table-responsive"><table class="table table-sm align-middle mb-0">
      <thead><tr><th>ID</th><th>Code</th><th>Name</th><th>kek_id</th><th>dek_ref</th><th>wrapped_dek (start)</th><th>phone_number.ciphertext (start)</th></tr></thead>
      <tbody><% s.sample.value.forEach(r => { %>
        <tr><td><%= r.id %></td><td><a href="/customers/<%= r.id %>#tab-encryption" class="mono"><%= r.customer_code %></a></td><td><%= r.full_name %></td><td class="mono"><%= r.kek_id %></td><td class="mono small"><%= r.dek_ref %></td><td class="mono small"><%= r.wrapped_preview %>…</td><td class="mono small"><%= r.phone_ct %>…</td></tr>
      <% }) %></tbody>
    </table></div>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
