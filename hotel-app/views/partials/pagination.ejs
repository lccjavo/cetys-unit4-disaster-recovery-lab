<% if (pages > 1) { %>
<nav aria-label="Pagination">
  <ul class="pagination pagination-sm mb-0 flex-wrap">
    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= qs({ page: page - 1 }) %>" aria-label="Previous">&laquo;</a></li>
    <% const start = Math.max(1, page - 3), end = Math.min(pages, page + 3); %>
    <% if (start > 1) { %><li class="page-item"><a class="page-link" href="<%= qs({ page: 1 }) %>">1</a></li><% if (start > 2) { %><li class="page-item disabled"><span class="page-link">…</span></li><% } %><% } %>
    <% for (let p = start; p <= end; p++) { %>
      <li class="page-item <%= p === page ? 'active' : '' %>"><a class="page-link" href="<%= qs({ page: p }) %>" <%= p === page ? 'aria-current=page' : '' %>><%= p %></a></li>
    <% } %>
    <% if (end < pages) { %><% if (end < pages - 1) { %><li class="page-item disabled"><span class="page-link">…</span></li><% } %><li class="page-item"><a class="page-link" href="<%= qs({ page: pages }) %>"><%= pages %></a></li><% } %>
    <li class="page-item <%= page >= pages ? 'disabled' : '' %>"><a class="page-link" href="<%= qs({ page: page + 1 }) %>" aria-label="Next">&raquo;</a></li>
  </ul>
</nav>
<% } %>
