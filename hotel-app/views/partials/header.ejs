<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrf %>">
  <title><%= title %> | Hotel Lab CETYS</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
<% if (user) { %>
<nav class="navbar navbar-expand-lg navbar-dark navbar-lab sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/"><i class="bi bi-building me-2"></i>Hotel Lab <span class="d-none d-sm-inline fw-normal small opacity-75">Gestión hotelera</span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mostrar navegación">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <%
          const nav = [];
          if (user.role === 'customer') {
            nav.push(['/', 'house', 'Mi cuenta'], [`/customers/${user.customer_id}`, 'person-vcard', 'Mi perfil'], ['/reservations', 'calendar-check', 'Mis reservaciones']);
          } else {
            nav.push(['/', 'speedometer2', 'Panel'], ['/customers', 'people', 'Clientes'], ['/reservations', 'calendar-check', 'Reservaciones']);
            if (user.role === 'admin') nav.push(['/security', 'shield-lock', 'Seguridad y cifrado'], ['/dr', 'life-preserver', 'Recuperación'], ['/accounts', 'person-gear', 'Cuentas']);
          }
        %>
        <% nav.forEach(([href, icon, label]) => { const active = href === '/' ? path === '/' : path.startsWith(href); %>
          <li class="nav-item"><a class="nav-link <%= active ? 'active' : '' %>" href="<%= href %>" <%= active ? 'aria-current=page' : '' %>><i class="bi bi-<%= icon %> me-1"></i><%= label %></a></li>
        <% }) %>
      </ul>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="badge rounded-pill text-bg-light" title="Servidor PostgreSQL actual"><span class="status-dot <%= dbHealth.status === 'up' ? 'ok' : dbHealth.status === 'down' ? 'down' : 'off' %>"></span>BD: <%= dbHealth.target %></span>
        <span class="badge rounded-pill text-bg-light" title="Key Vault"><span class="status-dot <%= vaultHealth.available && !vaultHealth.access_disabled && vaultHealth.vault_status === 'READY' ? 'ok' : 'down' %>"></span>Key Vault</span>
        <form method="post" action="/logout" class="d-flex align-items-center">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <span class="navbar-text text-white-50 small me-2 d-none d-xl-inline"><i class="bi bi-person-circle me-1"></i><%= user.display_name %> <span class="badge bg-info-subtle text-info-emphasis"><%= { admin: 'Administrador', staff: 'Personal', customer: 'Cliente' }[user.role] %></span></span>
          <button class="btn btn-sm btn-outline-light" type="submit"><i class="bi bi-box-arrow-right me-1"></i>Salir</button>
        </form>
      </div>
    </div>
  </div>
</nav>
<main class="container-fluid px-3 px-lg-4">
  <% if (dbHealth.status === 'down') { %>
    <div class="alert alert-danger d-flex gap-2 mt-3 mb-0" role="alert">
      <i class="bi bi-database-x fs-5"></i>
      <div><strong>Base de datos no disponible.</strong> Sin conexión con <code><%= dbHealth.target %></code> desde <%= fmtDate(dbHealth.downSince) %>. La aplicación sigue en línea; se reconectará al restablecerse el servidor o al promover el standby.<% if (user.role === 'admin') { %> <a class="alert-link" href="/dr">Ver recuperación</a><% } %></div>
    </div>
  <% } else if (dbHealth.server && dbHealth.server.in_recovery) { %>
    <div class="alert alert-warning mt-3 mb-0"><i class="bi bi-eye me-1"></i>El servidor actual <code><%= dbHealth.target %></code> está en modo standby (solo lectura).</div>
  <% } %>
  <% if (!vaultHealth.available) { %>
    <div class="alert alert-warning d-flex gap-2 mt-3 mb-0" role="alert">
      <i class="bi bi-safe fs-5"></i>
      <div><strong>Key Vault no disponible.</strong> Los datos operativos se muestran normalmente; los campos cifrados no se pueden leer temporalmente. <span class="small text-secondary">(<%= vaultHealth.error %>)</span></div>
    </div>
  <% } else if (vaultHealth.access_disabled) { %>
    <div class="alert alert-warning mt-3 mb-0"><i class="bi bi-lock me-1"></i><strong>Acceso a llaves deshabilitado</strong> en el Key Vault: el descifrado está bloqueado.</div>
  <% } else if (vaultHealth.vault_status === 'KEYSTORE_MISSING') { %>
    <div class="alert alert-danger mt-3 mb-0"><i class="bi bi-key me-1"></i><strong>KEK no encontrado:</strong> el Key Vault perdió su almacenamiento de llaves. Los datos cifrados se conservan, pero no se pueden descifrar hasta restaurar el KEK desde su respaldo.</div>
  <% } %>
  <% if (flash) { %>
    <div class="alert alert-<%= flash.type %> alert-dismissible fade show mt-3 mb-0" role="alert">
      <%= flash.message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
  <% } %>
<% } %>
