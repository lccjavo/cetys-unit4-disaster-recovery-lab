<%- include('partials/header') %>
<div class="login-wrap">
  <div class="card login-card shadow-lg m-3">
    <div class="card-body p-4 p-md-5">
      <div class="text-center mb-4">
        <div class="stat-card"><span class="stat-icon mb-2"><i class="bi bi-building"></i></span></div>
        <h1 class="h4 mb-1">Hotel Lab CETYS</h1>
        <p class="text-secondary small mb-0">Gestión de clientes y reservaciones con cifrado de sobre</p>
      </div>
      <% if (error) { %><div class="alert alert-danger py-2 small" role="alert"><%= error %></div><% } %>
      <% if (dbHealth.status === 'down') { %><div class="alert alert-warning py-2 small"><i class="bi bi-database-x me-1"></i>Base de datos no disponible (<%= dbHealth.target %>).</div><% } %>
      <form method="post" action="/login" class="needs-validation" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="mb-3">
          <label for="username" class="form-label">Usuario (correo)</label>
          <input id="username" name="username" type="email" class="form-control" required autocomplete="username" value="<%= username %>" placeholder="admin@hotel-lab.test">
          <div class="invalid-feedback">Capture un correo válido.</div>
        </div>
        <div class="mb-4">
          <label for="password" class="form-label">Contraseña</label>
          <input id="password" name="password" type="password" class="form-control" required autocomplete="current-password">
          <div class="invalid-feedback">Capture la contraseña.</div>
        </div>
        <button class="btn btn-primary w-100" type="submit" data-loading-text="Verificando..."><i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión</button>
      </form>
      <% if (labMode) { %>
      <div class="mt-4 small">
        <p class="fw-semibold mb-1">Cuentas de demostración (datos ficticios):</p>
        <ul class="mb-0 text-secondary">
          <li><code>admin@hotel-lab.test</code> (administrador)</li>
          <li><code>recepcion@hotel-lab.test</code> (personal)</li>
          <li><code>cliente001@hotel-lab.test</code> (cliente)</li>
        </ul>
        <p class="text-secondary mb-0 mt-1">Las contraseñas están en el README.</p>
      </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
