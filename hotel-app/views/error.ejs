<%- include('partials/header') %>
<% const code = locals.code; %>
<div class="<%= user ? 'py-4' : 'login-wrap' %>">
  <div class="card mx-auto" style="max-width: 680px">
    <div class="card-body p-4">
      <h1 class="h4"><i class="bi bi-<%= code === 403 || code === 'FORBIDDEN' ? 'shield-x' : code === 'DB_UNAVAILABLE' ? 'database-x' : 'exclamation-triangle' %> text-danger me-2"></i><%= title %></h1>
      <p><%= message %></p>
      <% if (code) { %><p class="small text-secondary mb-3">Code: <code><%= code %></code></p><% } %>
      <a href="/" class="btn btn-primary btn-sm"><i class="bi bi-house me-1"></i>Go to home</a>
      <% if (user && user.role === 'admin') { %><a href="/dr" class="btn btn-outline-primary btn-sm ms-1">Recovery</a><% } %>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
