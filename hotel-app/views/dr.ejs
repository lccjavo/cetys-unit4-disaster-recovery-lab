<%- include('partials/header') %>
<%
  const srv = s.db.server;
  const cnt = s.counts.ok ? s.counts.value : null;
  const arch = s.archiver.ok ? s.archiver.value : null;
  const ver = s.verification.ok ? s.verification.value : null;
  const roleLabel = (x) => !x.reachable ? 'Unavailable' : x.in_recovery ? 'Standby / in recovery' : 'Primary (writable)';
%>
<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-2" data-autorefresh="5">
  <div>
    <h1>Disaster recovery</h1>
    <p class="lead">Live state of PostgreSQL, replication, physical backups, WAL archiving and recovery verifications.</p>
  </div>
  <div class="d-flex align-items-center gap-3">
    <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch" id="autoRefreshToggle"><label class="form-check-label small" for="autoRefreshToggle">Refresh every 5 s</label></div>
    <form method="post" action="/dr/verify">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button type="submit" class="btn btn-cyan btn-sm" data-loading-text="Verifying..." <%= s.db.status === 'up' ? '' : 'disabled' %>><i class="bi bi-clipboard-check me-1"></i>Verify recovery</button>
    </form>
  </div>
</div>

<% if (s.splitBrainRisk) { %>
  <div class="alert alert-danger"><i class="bi bi-exclamation-octagon me-1"></i><strong>Split-brain risk:</strong> postgres-primary and postgres-standby are both accepting writes. Stop one of them immediately.</div>
<% } %>
<% if (s.control.fenced) { %>
  <div class="alert alert-warning small"><i class="bi bi-sign-stop me-1"></i>The original primary is <strong>fenced</strong> (file <code>/lab-control/primary.fenced</code>): it will not start as a primary even if <code>docker compose up</code> is run. To rebuild, use <code>./scripts/reset-lab.sh lab1</code>.</div>
<% } %>

<div class="row g-3">
  <div class="col-12 col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body">
    <div class="stat-label">Current app server</div>
    <div class="stat-value mono"><%= s.db.target %></div>
    <div class="small mt-1"><span class="status-dot <%= s.db.status === 'up' ? 'ok' : 'down' %>"></span><%= s.db.status === 'up' ? 'Database available' : 'Database unavailable' %></div>
  </div></div></div>
  <div class="col-12 col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body">
    <div class="stat-label">Server role</div>
    <div class="stat-value"><%= srv ? (srv.in_recovery ? 'Standby' : 'Primary') : 'N/A' %></div>
    <div class="small text-secondary"><%= srv ? `${srv.cluster_name} · timeline ${srv.timeline}` : (s.db.lastError || '') %></div>
  </div></div></div>
  <div class="col-12 col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body">
    <div class="stat-label">Current records</div>
    <div class="stat-value"><%= cnt ? cnt.customers : 'N/A' %> <span class="fs-6 fw-normal">customers</span></div>
    <div class="small text-secondary"><%= cnt ? `${cnt.reservations} reservations · ${cnt.users} users` : 'no connection' %></div>
  </div></div></div>
  <div class="col-12 col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body">
    <div class="stat-label">Last recovery verification</div>
    <% if (ver && ver.length) { const v = ver[0]; %>
      <div class="stat-value"><span class="badge text-bg-<%= v.outcome === 'success' ? 'success' : v.outcome === 'partial' ? 'warning' : 'danger' %>"><%= v.outcome %></span></div>
      <div class="small text-secondary"><%= fmtDate(v.verified_at) %> on <%= v.db_server %>: <%= v.decrypted_ok %>/<%= v.sampled_customers %> decrypted</div>
    <% } else { %><div class="stat-value">Never</div><div class="small text-secondary"><%= ver ? 'Click "Verify recovery"' : 'Database unavailable' %></div><% } %>
  </div></div></div>
</div>

<div class="card mt-3">
  <div class="card-header"><i class="bi bi-hdd-network me-1"></i>Lab PostgreSQL servers</div>
  <div class="card-body p-0"><div class="table-responsive"><table class="table align-middle mb-0">
    <thead><tr><th>Service</th><th>Status</th><th>Role</th><th>cluster_name</th><th>Timeline</th><th>Replication</th><th>Latency</th><th class="text-end">App connection</th></tr></thead>
    <tbody>
    <% s.candidates.forEach(x => { %>
      <tr class="<%= x.host === s.db.target ? 'table-info' : '' %>">
        <td class="mono fw-semibold"><%= x.host %><%= x.host === s.db.target ? ' (current)' : '' %></td>
        <td><span class="status-dot <%= x.reachable ? 'ok' : 'off' %>"></span><%= x.reachable ? 'Online' : 'Not responding' %><% if (!x.reachable) { %><div class="small text-secondary"><%= x.error %></div><% } %></td>
        <td><span class="badge text-bg-<%= !x.reachable ? 'secondary' : x.in_recovery ? 'warning' : 'success' %>"><%= roleLabel(x) %></span></td>
        <td class="mono small"><%= x.cluster_name || '' %></td>
        <td><%= x.timeline || '' %></td>
        <td class="small">
          <% if (x.reachable && x.in_recovery && x.standby) { %>
            WAL receiver: <strong><%= x.standby.receiver_status || 'not streaming' %></strong><br>
            Replay: <span class="mono"><%= x.standby.replay_lsn %></span><br>
            Delay: <%= x.standby.replay_delay_s !== null ? `${x.standby.replay_delay_s} s since the last transaction` : 'N/A' %>
          <% } else if (x.reachable && x.replicas) { %>
            <% if (!x.replicas.length) { %>No standbys connected<% } %>
            <% x.replicas.forEach(r => { %><div><span class="mono"><%= r.application_name %></span> <%= r.state %> (<%= r.sync_state %>), lag <%= r.lag_bytes %> bytes</div><% }) %>
          <% } %>
        </td>
        <td class="small"><%= x.latency_ms ? `${x.latency_ms} ms` : '' %></td>
        <td class="text-end">
          <% if (x.host !== s.db.target && x.reachable && !x.in_recovery) { %>
            <form method="post" action="/dr/switch" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="host" value="<%= x.host %>">
              <button type="submit" class="btn btn-sm btn-primary" data-confirm="The hotel application will use <%= x.host %> as its read/write server." data-confirm-title="Switch application server" data-confirm-variant="btn-primary"><i class="bi bi-plug me-1"></i>Connect the app here</button>
            </form>
          <% } else if (x.host === s.db.target) { %><span class="small text-secondary">In use</span><% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div></div>
</div>

<div class="row g-3 mt-1">
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-archive me-1"></i>Physical backups (pg_basebackup)</div>
      <div class="card-body p-0">
        <% if (!s.backups) { %><div class="empty-state"><i class="bi bi-exclamation-triangle"></i><p class="mt-2 mb-0">The backup volume is not mounted.</p></div>
        <% } else if (!s.backups.length) { %><div class="empty-state"><i class="bi bi-archive"></i><p class="mt-2 mb-0">No backups yet. Create one with <code>./scripts/backup.sh db</code></p></div>
        <% } else { %>
        <div class="table-responsive"><table class="table table-sm align-middle mb-0">
          <thead><tr><th>Backup</th><th>Finished</th><th>Source</th><th class="text-end">Customers</th><th class="text-end">Size</th><th>Verified</th></tr></thead>
          <tbody><% s.backups.slice(0, 8).forEach(b => { %>
            <tr><td class="mono small"><%= b.name %></td><td class="small"><%= fmtDate(b.finished_at) %></td><td class="mono small"><%= b.source_cluster %> TL<%= b.timeline %></td><td class="text-end"><%= b.customers_at_backup %></td><td class="text-end small"><%= b.size_bytes ? `${(b.size_bytes / 1048576).toFixed(1)} MB` : '' %></td>
            <td><span class="badge text-bg-<%= b.verified ? 'success' : 'danger' %>"><%= b.verified ? 'pg_verifybackup OK' : 'No' %></span></td></tr>
          <% }) %></tbody>
        </table></div>
        <% } %>
      </div>
    </div>
  </div>
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-journal-arrow-down me-1"></i>WAL archiving</div>
      <div class="card-body small">
        <% if (arch) { %>
          <div class="field-row d-flex justify-content-between"><span class="field-label">archive_mode (current server)</span><span class="badge text-bg-<%= arch.archive_mode === 'on' ? 'success' : 'secondary' %>"><%= arch.archive_mode %></span></div>
          <div class="field-row d-flex justify-content-between"><span class="field-label">Archived segments (pg_stat_archiver)</span><span><%= arch.archived_count %></span></div>
          <div class="field-row d-flex justify-content-between"><span class="field-label">Last archived WAL</span><span class="mono"><%= arch.last_archived_wal || 'none' %></span></div>
          <div class="field-row d-flex justify-content-between"><span class="field-label">Last archive time</span><span><%= arch.last_archived_time ? fmtDate(arch.last_archived_time) : 'N/A' %></span></div>
          <div class="field-row d-flex justify-content-between"><span class="field-label">Archive failures</span><span class="<%= arch.failed_count > 0 ? 'text-danger fw-semibold' : '' %>"><%= arch.failed_count %><%= arch.last_failed_wal ? ` (last: ${arch.last_failed_wal})` : '' %></span></div>
        <% } else { %><div class="alert alert-warning py-2">pg_stat_archiver unavailable: <%= s.archiver.message %></div><% } %>
        <% if (s.wal.available) { %>
          <div class="field-row d-flex justify-content-between"><span class="field-label">Files in /wal-archive</span><span><%= s.wal.count %> (<%= s.wal.segments %> segments)</span></div>
          <div class="field-row d-flex justify-content-between"><span class="field-label">Most recent file</span><span class="mono"><%= s.wal.latest || 'none' %></span></div>
          <% if (s.wal.history.length) { %><div class="field-row d-flex justify-content-between"><span class="field-label">Timeline histories</span><span class="mono"><%= s.wal.history.join(', ') %></span></div><% } %>
        <% } else { %><div class="alert alert-warning py-2 mt-2">Cannot read /wal-archive (<%= s.wal.error %>).</div><% } %>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mt-1">
  <div class="col-12 col-lg-4">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-bookmark-star me-1"></i>Restore points and PITR</div>
      <div class="card-body small">
        <% if (!s.control.restorePoints.length) { %><p class="text-secondary">No restore points yet. Use <code>./scripts/lab2-recovery-point.sh before_deletion</code></p><% } %>
        <ul class="timeline"><% s.control.restorePoints.slice(0, 5).forEach(r => { %><li><span class="mono fw-semibold"><%= r.name %></span><div class="text-secondary"><%= fmtDate(r.at) %> · LSN <%= r.lsn %></div></li><% }) %></ul>
        <% if (s.control.lastRestore) { const lr = s.control.lastRestore; %>
          <hr><div class="fw-semibold">Last PITR recovery</div>
          <div>Base backup: <span class="mono"><%= lr.backup %></span></div>
          <div>Target: <span class="mono"><%= lr.target_name || lr.target_time %></span></div>
          <div>Status: <span class="badge text-bg-<%= lr.status === 'completed' ? 'success' : 'warning' %>"><%= lr.status %></span> <%= lr.completed_at ? fmtDate(lr.completed_at) : fmtDate(lr.prepared_at) %></div>
          <% if (lr.duration_s) { %><div>Recovery duration: <%= lr.duration_s %> s</div><% } %>
          <% if (lr.customers !== undefined) { %><div>Customers recovered: <%= lr.customers %></div><% } %>
        <% } %>
      </div>
    </div>
  </div>
  <div class="col-12 col-lg-4">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-stopwatch me-1"></i>Recovery time measured by the app</div>
      <div class="card-body small">
        <% if (!s.db.incidents.length) { %><p class="text-secondary mb-0">No connection incidents recorded.</p><% } %>
        <ul class="timeline"><% s.db.incidents.forEach(i => { %>
          <li><span class="fw-semibold"><%= i.host %></span> down at <%= fmtDate(i.down_at) %>
          <div class="text-secondary"><%= i.up_at ? `Restored on ${i.recovered_on} after ${i.duration_s} s` : 'Incident in progress' %></div></li>
        <% }) %></ul>
      </div>
    </div>
  </div>
  <div class="col-12 col-lg-4">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-arrow-left-right me-1"></i>Failovers</div>
      <div class="card-body small">
        <% if (!s.control.failovers.length && !s.control.targets.length) { %><p class="text-secondary mb-0">No failovers recorded.</p><% } %>
        <ul class="timeline">
          <% s.control.failovers.slice(0, 3).forEach(f => { %><li><span class="fw-semibold">Promotion of <%= f.promoted %></span><div class="text-secondary"><%= fmtDate(f.promoted_at) %> · promotion <%= f.promote_seconds %> s<%= f.outage_seconds ? ` · total outage ${f.outage_seconds} s` : '' %></div></li><% }) %>
          <% s.control.targets.slice(0, 4).forEach(t => { %><li><span class="mono"><%= t.from %> &rarr; <%= t.to %></span><div class="text-secondary"><%= fmtDate(t.at) %> · <%= t.actor %> · <%= t.reason %></div></li><% }) %>
        </ul>
      </div>
    </div>
  </div>
</div>

<% if (ver && ver.length > 1) { %>
<div class="card mt-3">
  <div class="card-header"><i class="bi bi-clipboard-data me-1"></i>Verification history</div>
  <div class="card-body p-0"><div class="table-responsive"><table class="table table-sm mb-0">
    <thead><tr><th>Date</th><th>Server</th><th class="text-end">Customers</th><th class="text-end">Reservations</th><th class="text-end">Decrypted</th><th>Outcome</th></tr></thead>
    <tbody><% ver.forEach(v => { %><tr><td class="small"><%= fmtDate(v.verified_at) %></td><td class="mono"><%= v.db_server %></td><td class="text-end"><%= v.customers_count %></td><td class="text-end"><%= v.reservations_count %></td><td class="text-end"><%= v.decrypted_ok %>/<%= v.sampled_customers %></td><td><span class="badge text-bg-<%= v.outcome === 'success' ? 'success' : 'warning' %>"><%= v.outcome %></span></td></tr><% }) %></tbody>
  </table></div></div>
</div>
<% } %>
<%- include('partials/footer') %>
