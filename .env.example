# =====================================================================
# CETYS Unidad 4: configuracion local del laboratorio
# Genere su .env con:  ./scripts/setup-env.sh
# El script reemplaza cada CHANGE_ME por un secreto aleatorio local.
# Docker Compose funciona aun sin .env (usa valores por defecto inseguros
# solo aptos para pruebas), pero en clase use siempre setup-env.sh.
# =====================================================================

COMPOSE_PROJECT_NAME=cetys-disaster-recovery

# ---------------------------------------------------------------------
# PostgreSQL (cuenta administradora del servidor)
# Dentro de Docker el servidor se llama postgres-primary (puerto 5432).
# Desde su computadora (DBeaver) use 127.0.0.1 y POSTGRES_HOST_PORT.
# ---------------------------------------------------------------------
POSTGRES_HOST=postgres-primary
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_STANDBY_HOST_PORT=5434
POSTGRES_RECOVERY_HOST_PORT=5435
POSTGRES_DB=hotel_lab
POSTGRES_USER=hotel_admin
POSTGRES_PASSWORD=CHANGE_ME

# Rol de replicacion fisica (laboratorio 1)
REPLICATION_USER=replicator
REPLICATION_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------
# Credenciales de la aplicacion del hotel (rol sin privilegios de superusuario)
# ---------------------------------------------------------------------
DB_HOST=postgres-primary
DB_PORT=5432
DB_NAME=hotel_lab
DB_USER=hotel_app
DB_PASSWORD=CHANGE_ME

# Cuenta de SOLO LECTURA para inspeccion con DBeaver
DB_READER_USER=lab_reader
DB_READER_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------
# Aplicaciones (puertos publicados solo en 127.0.0.1)
# ---------------------------------------------------------------------
HOTEL_APP_PORT=3000
KEY_VAULT_APP_PORT=3001
# API interna del Key Vault: solo accesible dentro de la red de Docker (no se publica).
KEY_VAULT_URL=http://key-vault:8200

# Autenticacion interna hotel-app -> key-vault
KEY_VAULT_SERVICE_TOKEN=CHANGE_ME

# Secretos de sesion
HOTEL_SESSION_SECRET=CHANGE_ME
VAULT_SESSION_SECRET=CHANGE_ME

# Administrador de la GUI del Key Vault (cuenta independiente del hotel)
VAULT_ADMIN_USER=vault_admin
VAULT_ADMIN_PASSWORD=VaultAdmin2026!

# Frase de paso para cifrar los respaldos independientes de KEK.
# Si la cambia, los respaldos anteriores ya no se pueden descifrar.
VAULT_BACKUP_PASSPHRASE=CHANGE_ME

# Contrasenas de las cuentas de demostracion del hotel (datos ficticios, documentadas en README)
HOTEL_DEMO_ADMIN_PASSWORD=Admin2026!
HOTEL_DEMO_STAFF_PASSWORD=Staff2026!
HOTEL_DEMO_CUSTOMER_PASSWORD=Cliente2026!

# ---------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------
# NODE_ENV=production es el valor recomendado en los contenedores.
NODE_ENV=production
LAB_MODE=true
# true: hotel-app aplica migraciones y genera datos SOLO si la base esta vacia y sin marca de seed.
AUTO_INIT=true
