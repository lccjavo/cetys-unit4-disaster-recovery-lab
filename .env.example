# =====================================================================
# CETYS Unit 4: local lab configuration
# Generate your .env with:  ./scripts/setup-env.sh
# The script replaces every CHANGE_ME value with a random local secret.
# Docker Compose also works without .env (it uses insecure defaults that
# are only suitable for testing), but in class always run setup-env.sh.
# =====================================================================

COMPOSE_PROJECT_NAME=cetys-disaster-recovery

# ---------------------------------------------------------------------
# PostgreSQL (server administrator account)
# Inside Docker the server is called postgres-primary (port 5432).
# From your computer (DBeaver) use 127.0.0.1 and POSTGRES_HOST_PORT.
# ---------------------------------------------------------------------
POSTGRES_HOST=postgres-primary
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_STANDBY_HOST_PORT=5434
POSTGRES_RECOVERY_HOST_PORT=5435
POSTGRES_DB=hotel_lab
POSTGRES_USER=hotel_admin
POSTGRES_PASSWORD=CHANGE_ME

# Physical replication role (Lab 1)
REPLICATION_USER=replicator
REPLICATION_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------
# Hotel application credentials (non-superuser role)
# ---------------------------------------------------------------------
DB_HOST=postgres-primary
DB_PORT=5432
DB_NAME=hotel_lab
DB_USER=hotel_app
DB_PASSWORD=CHANGE_ME

# READ-ONLY account for inspection with DBeaver
DB_READER_USER=lab_reader
DB_READER_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------
# Applications (ports published on 127.0.0.1 only)
# ---------------------------------------------------------------------
HOTEL_APP_PORT=3000
KEY_VAULT_APP_PORT=3001
# Key Vault internal API: reachable only inside the Docker network (not published).
KEY_VAULT_URL=http://key-vault:8200

# Internal authentication hotel-app -> key-vault
KEY_VAULT_SERVICE_TOKEN=CHANGE_ME

# Session secrets
HOTEL_SESSION_SECRET=CHANGE_ME
VAULT_SESSION_SECRET=CHANGE_ME

# Key Vault GUI administrator (account separate from the hotel)
VAULT_ADMIN_USER=vault_admin
VAULT_ADMIN_PASSWORD=VaultAdmin2026!

# Passphrase that encrypts the independent KEK backups.
# If you change it, earlier backups can no longer be decrypted.
VAULT_BACKUP_PASSPHRASE=CHANGE_ME

# Passwords of the hotel demo accounts (fictional data, documented in the README)
HOTEL_DEMO_ADMIN_PASSWORD=Admin2026!
HOTEL_DEMO_STAFF_PASSWORD=Staff2026!
HOTEL_DEMO_CUSTOMER_PASSWORD=Customer2026!

# ---------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------
# NODE_ENV=production is the recommended value inside the containers.
NODE_ENV=production
LAB_MODE=true
# true: hotel-app applies migrations and seeds data ONLY if the database is empty and has no seed marker.
AUTO_INIT=true
