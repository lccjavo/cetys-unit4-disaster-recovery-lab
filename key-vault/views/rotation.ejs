<%- include('partials/header') %>
<div class="page-header">
  <h1>Key rotation</h1>
  <p class="lead">Create a new KEK version. Future wrapping uses the new version; earlier ones stay decryptable.</p>
</div>
<div class="row g-3">
  <div class="col-12 col-lg-5">
    <div class="card">
      <div class="card-header"><i class="bi bi-arrow-repeat me-1"></i>Controlled rotation</div>
      <div class="card-body">
        <p>Current active KEK: <span class="mono fw-semibold"><%= s.active_kek_id || 'none' %></span></p>
        <p class="small text-secondary">Rotating generates <span class="mono">kek-v<%= s.kek_count + 1 %></span>, marks it active, retires the previous version and creates an automatic keystore backup.</p>
        <form method="post" action="/rotation" id="rotateForm">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" class="btn btn-cyan" <%= s.vault_status !== 'READY' ? 'disabled' : '' %>
            data-confirm="A new KEK will be created and become active for all future wrapping. Earlier KEKs are kept."
            data-confirm-title="Rotate KEK" data-confirm-variant="btn-cyan"><i class="bi bi-plus-circle me-1"></i>Create kek-v<%= s.kek_count + 1 %> and activate it</button>
        </form>
      </div>
    </div>
    <div class="card mt-3"><div class="card-body small">
      <h2 class="h6">How to verify it in the hotel</h2>
      <ol class="mb-0">
        <li>Rotate the KEK here.</li>
        <li>At <code>http://localhost:3000/customers/new</code> create a new customer.</li>
        <li>On its <em>Encryption details</em> tab the <code>kek_id</code> is the new one.</li>
        <li>An existing customer keeps <code>kek-v1</code> and can still reveal its data.</li>
      </ol>
    </div></div>
  </div>
  <div class="col-12 col-lg-7">
    <div class="card">
      <div class="card-header"><i class="bi bi-clock-history me-1"></i>Rotation history</div>
      <div class="card-body p-0">
        <% if (!s.rotation_history.length) { %>
          <div class="empty-state"><i class="bi bi-clock"></i><p class="mt-2 mb-0">No history.</p></div>
        <% } else { %>
        <div class="table-responsive"><table class="table align-middle mb-0">
          <thead><tr><th>Date</th><th>Action</th><th>Detail</th><th>Actor</th></tr></thead>
          <tbody>
          <% s.rotation_history.forEach(h => { %>
            <tr><td class="small"><%= fmtDate(h.at) %></td><td><span class="badge text-bg-light border"><%= h.action %></span></td>
            <td class="mono small"><%= h.action === 'rotate' ? `${h.from} -> ${h.kek_id}` : (h.kek_id || ((h.added || []).length ? 'added: ' + h.added.join(', ') : (h.from_backup || ''))) %></td>
            <td class="small"><%= h.actor %></td></tr>
          <% }) %>
          </tbody></table></div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
