<%- include('partials/header') %>
<div class="page-header">
  <h1>KEK backup and recovery</h1>
  <p class="lead">Backups independent from the PostgreSQL backups. They are stored encrypted (AES-256-GCM, key derived with scrypt from <code>VAULT_BACKUP_PASSPHRASE</code>) on the <code>vault-backups</code> volume (<code><%= backupDir %></code>).</p>
</div>
<div class="row g-3">
  <div class="col-12 col-lg-4">
    <div class="card">
      <div class="card-header"><i class="bi bi-archive me-1"></i>Create backup</div>
      <div class="card-body">
        <p class="small">Key store status: <%- include('partials/statusbadge', { st: s.vault_status }) %></p>
        <p class="small">Last backup: <strong><%= s.last_backup ? fmtDate(s.last_backup.at) : 'never' %></strong></p>
        <form method="post" action="/backups">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-primary" type="submit" data-loading-text="Backing up..." <%= s.vault_status !== 'READY' ? 'disabled' : '' %>><i class="bi bi-download me-1"></i>Back up KEKs now</button>
        </form>
        <p class="small text-secondary mt-3 mb-0">From the terminal: <code>./scripts/backup.sh keys</code></p>
      </div>
    </div>
    <div class="card mt-3"><div class="card-body small">
      <h2 class="h6">Restore rules</h2>
      <ul class="mb-0">
        <li>Only missing KEKs are added.</li>
        <li>If a KEK exists with the same <code>kek_id</code> but different material, the restore is rejected (it is never silently replaced).</li>
        <li>The GCM tag and the SHA-256 checksum of the content are verified.</li>
      </ul>
    </div></div>
  </div>
  <div class="col-12 col-lg-8">
    <div class="card">
      <div class="card-header"><i class="bi bi-list-ul me-1"></i>Available backups (<%= backups.length %>)</div>
      <div class="card-body p-0">
        <% if (!backups.length) { %>
          <div class="empty-state"><i class="bi bi-archive"></i><p class="mt-2 mb-0">No backups yet.</p></div>
        <% } else { %>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
          <thead><tr><th>File</th><th>Date</th><th>KEKs</th><th>SHA-256</th><th class="text-end">Action</th></tr></thead>
          <tbody>
          <% backups.forEach((b, i) => { %>
            <tr>
              <td class="mono small"><%= b.file %></td>
              <td class="small"><%= fmtDate(b.created_at) %></td>
              <td class="small"><%= b.kek_count ?? 'N/A' %><%= b.owner_count != null ? ` (${b.owner_count} customers)` : '' %></td>
              <td class="mono small"><%= (b.sha256 || '').slice(0, 12) %></td>
              <td class="text-end">
                <form method="post" action="/backups/restore" id="restore-<%= i %>" class="d-inline">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="hidden" name="file" value="<%= b.file %>">
                  <button type="submit" class="btn btn-sm btn-outline-primary"
                    data-confirm="Missing KEKs will be restored from <%= b.file %>. Existing KEKs are not modified."
                    data-confirm-title="Restore KEK" data-confirm-variant="btn-primary"><i class="bi bi-upload me-1"></i>Restore</button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody></table></div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
